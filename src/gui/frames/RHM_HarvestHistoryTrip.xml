<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI>
    <GuiElement profile="uiInGameMenuFrame">
        <!-- Page header with icon and title -->
        <GuiElement profile="fs25_menuHeaderPanel">
            <Bitmap profile="fs25_menuHeaderIconBg">
                <Bitmap profile="fs25_menuHeaderIcon" imageSliceId="rhmUi.icon_tab_trip" />
            </Bitmap>
            <Text profile="fs25_menuHeaderTitle" text="$l10n_rhm_tab_trip" />
        </GuiElement>

        <!-- CARD 1: Field & Harvest Throughput -->
        <Bitmap profile="rhmCardContainer" position="20px -54px" size="440px 530px">
            <Bitmap profile="rhmIcon" imageSliceId="rhmUi.icon_yield" position="20px -16px" size="24px 24px" />
            <Text profile="rhmCardTitle" position="54px -18px" size="365px 22px" text="$l10n_rhm_card_field_harvest" />

            <!-- Row 1: Field & Crop Type -->
            <Text profile="rhmCardSubValue" position="24px -56px" size="180px 16px" text="$l10n_rhm_field_number" />
            <Text profile="rhmCardHighlightValue" id="fieldNumberText" position="24px -76px" size="180px 32px" text="--" textSize="26px" />

            <Text profile="rhmCardSubValue" position="230px -56px" size="185px 16px" text="$l10n_rhm_crop_type" />
            <Text profile="rhmCardValue" id="cropTypeText" position="230px -76px" size="185px 32px" text="--" textSize="26px" />

            <!-- Row 2: Harvested Area -->
            <Text profile="rhmCardSubValue" position="24px -144px" size="390px 16px" text="$l10n_rhm_harvested_area" />
            <Text profile="rhmCardValue" id="harvestedAreaText" position="24px -164px" size="390px 34px" text="0.00 ha" textSize="28px" />
            <Text profile="rhmCardDetailText" position="24px -200px" size="390px 16px" text="$l10n_rhm_detail_area" />

            <!-- Row 3: Clean Grain Harvest -->
            <Text profile="rhmCardSubValue" position="24px -236px" size="390px 16px" text="$l10n_rhm_clean_harvest" />
            <Text profile="rhmCardHighlightValue" id="harvestedVolumeText" position="24px -256px" size="390px 34px" text="0.0 t" textSize="28px" />
            <Text profile="rhmCardDetailText" id="harvestedVolumeSubText" position="24px -292px" size="390px 16px" text="0 L" />

            <!-- Row 4: Average Yield -->
            <Text profile="rhmCardSubValue" position="24px -328px" size="390px 16px" text="$l10n_rhm_average_yield" />
            <Text profile="rhmCardValue" id="avgYieldText" position="24px -348px" size="390px 34px" text="0.00 t/ha" textSize="28px" />
            <Text profile="rhmCardDetailText" position="24px -384px" size="390px 16px" text="$l10n_rhm_detail_yield" />

            <!-- Row 5: Rate / Status -->
            <Text profile="rhmCardSubValue" position="24px -420px" size="390px 16px" text="$l10n_rhm_fleet_throughput" />
            <Text profile="rhmCardHighlightValue" id="avgThroughputText" position="24px -440px" size="390px 34px" text="0.0 t/h" textSize="28px" />
            <Text profile="rhmCardDetailText" position="24px -476px" size="390px 16px" text="$l10n_rhm_detail_throughput" />
        </Bitmap>

        <!-- CARD 2: Losses & Finances -->
        <Bitmap profile="rhmCardContainer" position="480px -54px" size="440px 530px">
            <Bitmap profile="rhmIcon" imageSliceId="rhmUi.icon_loss" position="20px -16px" size="24px 24px" />
            <Text profile="rhmCardTitle" position="54px -18px" size="365px 22px" text="$l10n_rhm_card_loss_finances" />

            <!-- Row 1: Lost Volume -->
            <Text profile="rhmCardSubValue" position="24px -56px" size="390px 16px" text="$l10n_rhm_loss_volume" />
            <Text profile="rhmCardWarningValue" id="lossVolumeText" position="24px -76px" size="390px 34px" text="0.0 t" textSize="28px" />
            <Text profile="rhmCardDetailText" id="lossVolumeSubText" position="24px -112px" size="390px 16px" text="0 L" />

            <!-- Row 2: Loss Share % -->
            <Text profile="rhmCardSubValue" position="24px -156px" size="390px 16px" text="$l10n_rhm_loss_share" />
            <Text profile="rhmCardWarningValue" id="lossPercentText" position="24px -176px" size="390px 34px" text="0.00%" textSize="28px" />
            <Text profile="rhmCardDetailText" id="lossRatingSubText" position="24px -212px" size="390px 16px" text="$l10n_rhm_detail_loss_rating" />

            <!-- Row 3: Financial Loss -->
            <Text profile="rhmCardSubValue" position="24px -256px" size="390px 16px" text="$l10n_rhm_financial_loss" />
            <Text profile="rhmCardAlertValue" id="lossMoneyText" position="24px -276px" size="390px 34px" text="-$0" textSize="28px" />
            <Text profile="rhmCardDetailText" position="24px -312px" size="390px 16px" text="$l10n_rhm_detail_financial_loss" />

            <!-- Row 4: Efficiency Rank -->
            <Text profile="rhmCardSubValue" position="24px -356px" size="390px 16px" text="$l10n_rhm_efficiency_index" />
            <Text profile="rhmCardHighlightValue" id="efficiencyRankBadge" position="24px -376px" size="390px 34px" text="[A]" textSize="28px" />
            <Text profile="rhmCardDetailText" id="efficiencyRankDesc" position="24px -412px" size="390px 16px" text="$l10n_rhm_rank_title_a" />
        </Bitmap>

        <!-- CARD 3: Combine Performance & Session Duration -->
        <Bitmap profile="rhmCardContainer" position="940px -54px" size="440px 530px">
            <Bitmap profile="rhmIcon" imageSliceId="rhmUi.icon_speed" position="20px -16px" size="24px 24px" />
            <Text profile="rhmCardTitle" position="54px -18px" size="365px 22px" text="$l10n_rhm_card_performance" />

            <!-- Row 1: Working Speed -->
            <Text profile="rhmCardSubValue" position="24px -56px" size="390px 16px" text="$l10n_rhm_avg_working_speed" />
            <Text profile="rhmCardValue" id="avgSpeedText" position="24px -76px" size="390px 34px" text="0.0 km/h" textSize="28px" />
            <Text profile="rhmCardDetailText" position="24px -112px" size="390px 16px" text="$l10n_rhm_detail_speed" />

            <!-- Row 2: Engine Load -->
            <Text profile="rhmCardSubValue" position="24px -156px" size="390px 16px" text="$l10n_rhm_avg_engine_load" />
            <Text profile="rhmCardHighlightValue" id="avgLoadText" position="24px -176px" size="390px 34px" text="0%" textSize="28px" />
            <Text profile="rhmCardDetailText" position="24px -212px" size="390px 16px" text="$l10n_rhm_detail_load" />

            <!-- Row 3: Session Duration -->
            <Text profile="rhmCardSubValue" position="24px -256px" size="390px 16px" text="$l10n_rhm_session_duration" />
            <Text profile="rhmCardValue" id="sessionDurationText" position="24px -276px" size="390px 34px" text="00:00" textSize="28px" />
            <Text profile="rhmCardDetailText" position="24px -312px" size="390px 16px" text="$l10n_rhm_detail_duration" />

            <!-- Row 4: Machine Condition -->
            <Text profile="rhmCardSubValue" position="24px -356px" size="390px 16px" text="$l10n_rhm_fleet_wear_state" />
            <Text profile="rhmCardValue" id="machineWearText" position="24px -376px" size="390px 34px" text="0%" textSize="28px" />
            <Text profile="rhmCardDetailText" position="24px -412px" size="390px 16px" text="$l10n_rhm_detail_wear" />
        </Bitmap>

        <!-- FOOTER & ACTION BAR -->
        <GuiElement profile="rhmDividerLine" position="20px -594px" size="1360px 1px" />
        <Text profile="rhmFooterText" position="20px -604px" size="980px 36px" text="$l10n_rhm_trip_footer_hint" />

        <!-- Reset Trip Button -->
        <Button id="resetButton" profile="rhmActionButton" position="1020px -604px" size="360px 38px" text="$l10n_rhm_btn_reset_trip" inputAction="MENU_EXTRA_1" onClick="onClickResetTrip">
            <Bitmap profile="rhmIcon" imageSliceId="rhmUi.icon_reset" position="14px -8px" size="22px 22px" />
        </Button>
    </GuiElement>
</GUI>

<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI>
    <GuiElement profile="uiInGameMenuFrame">
        <!-- Page header with icon and title -->
        <GuiElement profile="fs25_menuHeaderPanel">
            <Bitmap profile="fs25_menuHeaderIconBg">
                <Bitmap profile="fs25_menuHeaderIcon" imageSliceId="rhmUi.icon_tab_fleet" />
            </Bitmap>
            <Text profile="fs25_menuHeaderTitle" text="$l10n_rhm_tab_fleet" />
        </GuiElement>

        <Text profile="rhmDescriptiveText" text="$l10n_rhm_tab_fleet_desc" position="20px -46px" width="1400px" />

        <!-- Fleet Filter Bar (Active / All / Sold) -->
        <GuiElement id="fleetFilterBar" profile="rhmTopNavContainer" position="20px -70px" size="1360px 38px">
            <Button id="btnFilterActive" profile="rhmSubTabFilterActive" position="0px 0px" size="140px 34px" text="$l10n_rhm_filter_active" onClick="onClickFilterActive" />
            <Button id="btnFilterAll" profile="rhmSubTabFilter" position="148px 0px" size="140px 34px" text="$l10n_rhm_filter_all" onClick="onClickFilterAll" />
            <Button id="btnFilterSold" profile="rhmSubTabFilter" position="296px 0px" size="140px 34px" text="$l10n_rhm_filter_sold" onClick="onClickFilterSold" />
        </GuiElement>

        <!-- ================================================================= -->
        <!-- VIEW MODE 1: FLEET TELEMETRY PANEL                                -->
        <!-- ================================================================= -->
        <GuiElement id="fleetPanel" profile="rhmSubPanel" position="0px 0px" size="1400px 700px">

            <!-- Machine Switcher / Selector Header -->
            <GuiElement profile="rhmStatusBandContainer" position="20px -110px" size="1360px 38px">
                <RoundCorner profile="rhmMachineHeaderBox" />
                <Button id="btnPrevCombine" profile="rhmSelectorButton" position="8px -4px" size="32px 30px" text="&lt;" onClick="onClickPrevCombine" />
                <Button id="btnNextCombine" profile="rhmSelectorButton" position="44px -4px" size="32px 30px" text="&gt;" onClick="onClickNextCombine" />
                <Bitmap profile="rhmIcon" imageSliceId="rhmUi.icon_combine_badge" position="88px -7px" size="24px 24px" />
                <Text profile="rhmStatusText" id="selectedCombineTitle" position="122px -8px" size="780px 22px" text="--" />
                <Text profile="rhmCardHeaderVehicle" id="fleetCountText" position="930px -8px" size="410px 22px" text="--" textAlignment="right" />
            </GuiElement>

            <!-- CARD 1: Status & Field -->
            <GuiElement profile="rhmCardContainer" position="20px -156px" size="440px 214px">
                <RoundCorner profile="rhmCardSurface" />
                <Text profile="rhmCardTitle" position="20px -16px" size="400px 20px" text="$l10n_rhm_card_field_harvest" />

                <!-- Row 1: Field & Crop -->
                <Text profile="rhmCardSubValue" position="20px -44px" size="190px 13px" text="$l10n_rhm_col_field" />
                <Text profile="rhmCardValue" id="card1FieldNumber" position="20px -60px" size="190px 28px" text="--" />

                <Text profile="rhmCardSubValue" position="220px -44px" size="195px 13px" text="$l10n_rhm_crop_type" />
                <Text profile="rhmCardValue" id="card1CropType" position="220px -60px" size="195px 28px" text="--" />

                <!-- Row 2: Driver & Cutter Width -->
                <Text profile="rhmCardSubValue" position="20px -98px" size="190px 13px" text="$l10n_rhm_col_driver" />
                <Text profile="rhmCardValue" id="card1DriverText" position="20px -114px" size="190px 28px" text="--" />

                <Text profile="rhmCardSubValue" position="220px -98px" size="195px 13px" text="$l10n_rhm_col_cutter" />
                <Text profile="rhmCardValue" id="card1CutterWidth" position="220px -114px" size="195px 28px" text="0.0 m" />

                <!-- Row 3: Grain Tank (Full Width) -->
                <Text profile="rhmCardSubValue" position="20px -152px" size="400px 13px" text="$l10n_rhm_col_tank" />
                <Text profile="rhmCardValue" id="card1GrainTank" position="20px -168px" size="400px 26px" text="0 L (0%)" textSize="20px" />
            </GuiElement>

            <!-- CARD 2: Performance & Harvest -->
            <GuiElement profile="rhmCardContainer" position="480px -156px" size="440px 214px">
                <RoundCorner profile="rhmCardSurface" />
                <Text profile="rhmCardTitle" position="20px -16px" size="400px 20px" text="$l10n_rhm_card_performance" />

                <!-- Row 1: Speed & Throughput -->
                <Text profile="rhmCardSubValue" position="20px -44px" size="190px 13px" text="$l10n_rhm_col_speed" />
                <Text profile="rhmCardValue" id="card2SpeedText" position="20px -60px" size="190px 28px" text="0.0 km/h" />

                <Text profile="rhmCardSubValue" position="220px -44px" size="195px 13px" text="$l10n_rhm_col_throughput" />
                <Text profile="rhmCardValue" id="card2ThroughputText" position="220px -60px" size="195px 28px" text="0.0 t/h" />

                <!-- Row 2: Harvested & Realtime Yield -->
                <Text profile="rhmCardSubValue" position="20px -98px" size="190px 13px" text="$l10n_rhm_col_harvested" />
                <Text profile="rhmCardValue" id="card2HarvestedText" position="20px -114px" size="190px 28px" text="0.0 t" textSize="20px" />

                <Text profile="rhmCardSubValue" position="220px -98px" size="195px 13px" text="$l10n_rhm_col_yield" />
                <Text profile="rhmCardValue" id="card2YieldText" position="220px -114px" size="195px 28px" text="0.00 t/ha" />

                <!-- Row 3: Operating Hours (Full Width) -->
                <Text profile="rhmCardSubValue" position="20px -152px" size="400px 13px" text="$l10n_rhm_col_hours" />
                <Text profile="rhmCardValue" id="card2OperatingHours" position="20px -168px" size="400px 26px" text="0.0 h" textSize="20px" />
            </GuiElement>

            <!-- CARD 3: Load & Losses -->
            <GuiElement profile="rhmCardContainer" position="940px -156px" size="440px 214px">
                <RoundCorner profile="rhmCardSurface" />
                <Text profile="rhmCardTitle" position="20px -16px" size="400px 20px" text="$l10n_rhm_card_loss_finances" />

                <!-- Row 1: Engine Load & Loss % -->
                <Text profile="rhmCardSubValue" position="20px -44px" size="190px 13px" text="$l10n_rhm_col_load" />
                <Text profile="rhmCardValue" id="card3EngineLoad" position="20px -60px" size="190px 28px" text="0%" />

                <Text profile="rhmCardSubValue" position="220px -44px" size="195px 13px" text="$l10n_rhm_col_loss" />
                <Text profile="rhmCardValue" id="card3LossPct" position="220px -60px" size="195px 28px" text="0.00%" />

                <!-- Row 2: Loss Volume & Efficiency Rank -->
                <Text profile="rhmCardSubValue" position="20px -98px" size="190px 13px" text="$l10n_rhm_loss_volume" />
                <Text profile="rhmCardValue" id="card3LossVolume" position="20px -114px" size="190px 28px" text="0.0 t" textSize="20px" />

                <Text profile="rhmCardSubValue" position="220px -98px" size="195px 13px" text="$l10n_rhm_col_rank" />
                <Text profile="rhmCardValue" id="card3RankText" position="220px -114px" size="195px 28px" text="[A]" textSize="20px" />

                <!-- Row 3: Wear State (Full Width) -->
                <Text profile="rhmCardSubValue" position="20px -152px" size="400px 13px" text="$l10n_rhm_col_wear" />
                <Text profile="rhmCardValue" id="card3WearText" position="20px -168px" size="400px 26px" text="0%" textSize="20px" />
            </GuiElement>

            <!-- Fleet Table Header -->
            <GuiElement profile="rhmTableHeaderContainer" position="20px -378px" size="1360px 26px">
                <RoundCorner profile="rhmTableHeaderBox" />
                <Button profile="rhmTableHeader" position="10px -3px" size="310px 20px" text="$l10n_rhm_col_machine" handleFocus="false" />
                <Button profile="rhmTableHeader" position="330px -3px" size="120px 20px" text="$l10n_rhm_col_field" handleFocus="false" />
                <Button profile="rhmTableHeader" position="460px -3px" size="190px 20px" text="$l10n_rhm_col_status" handleFocus="false" />
                <Button profile="rhmTableHeader" position="660px -3px" size="140px 20px" text="$l10n_rhm_col_speed" handleFocus="false" />
                <Button profile="rhmTableHeader" position="810px -3px" size="140px 20px" text="$l10n_rhm_col_load" handleFocus="false" />
                <Button profile="rhmTableHeader" position="960px -3px" size="140px 20px" text="$l10n_rhm_col_loss" handleFocus="false" />
                <Button profile="rhmTableHeader" position="1110px -3px" size="230px 20px" text="$l10n_rhm_col_tank" handleFocus="false" />
            </GuiElement>

            <!-- Fleet Table Content -->
            <SmoothList id="fleetTable" profile="rhmTable" position="20px -406px" size="1360px 250px" onClick="onClickListItem" onSelectionChanged="onListSelectionChanged">
                <ListItem profile="rhmListItem">
                    <Text profile="rhmRowCellLeft" name="machineName" position="10px 0px" size="310px 38px" />
                    <Text profile="rhmRowCellLeft" name="fieldStr" position="330px 0px" size="120px 38px" />
                    <Text profile="rhmRowCellLeft" name="statusStr" position="460px 0px" size="190px 38px" />
                    <Text profile="rhmRowCellLeft" name="speedStr" position="660px 0px" size="140px 38px" />
                    <Text profile="rhmRowCellLeft" name="loadStr" position="810px 0px" size="140px 38px" />
                    <Text profile="rhmRowCellLeft" name="lossStr" position="960px 0px" size="140px 38px" />
                    <Text profile="rhmRowCellLeft" name="tankStr" position="1110px 0px" size="230px 38px" />
                </ListItem>
            </SmoothList>

            <!-- Scrollbar Slider -->
            <ThreePartBitmap profile="rhmSliderBox" position="1385px -406px" size="6px 250px">
                <Slider profile="fs25_listSlider" dataElementId="fleetTable" />
            </ThreePartBitmap>
        </GuiElement>


    </GuiElement>
</GUI>

<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI>
    <GuiElement profile="uiInGameMenuFrame">
        <!-- Page header with icon and title -->
        <GuiElement profile="fs25_menuHeaderPanel">
            <Bitmap profile="fs25_menuHeaderIconBg">
                <Bitmap profile="fs25_menuHeaderIcon" imageSliceId="rhmUi.icon_tab_fleet" />
            </Bitmap>
            <Text profile="fs25_menuHeaderTitle" text="$l10n_rhm_tab_fleet" />
        </GuiElement>

        <Text profile="rhmDescriptiveText" text="$l10n_rhm_tab_fleet_desc" position="20px -46px" width="1400px" />

        <!-- Sub-Tab Navigation Bar -->
        <GuiElement profile="rhmTopNavContainer" position="20px -70px" size="620px 38px">
            <Button id="btnSubTabFleet" profile="rhmSubTabFleetActive" position="0px 0px" size="260px 34px" text="$l10n_rhm_btn_subtab_fleet" onClick="onClickSubTabFleet">
                <Bitmap profile="rhmIcon" imageSliceId="rhmUi.icon_tab_fleet" position="14px -6px" size="22px 22px" />
            </Button>
            <Button id="btnSubTabHistory" profile="rhmSubTabHistory" position="270px 0px" size="330px 34px" text="$l10n_rhm_btn_subtab_history" onClick="onClickSubTabHistory">
                <Bitmap profile="rhmIcon" imageSliceId="rhmUi.icon_tab_history" position="14px -6px" size="22px 22px" />
            </Button>
        </GuiElement>

        <!-- ================================================================= -->
        <!-- VIEW MODE 1: FLEET TELEMETRY PANEL                                -->
        <!-- ================================================================= -->
        <GuiElement id="fleetPanel" profile="rhmSubPanel" position="0px 0px" size="1400px 700px">
            <!-- Machine Switcher / Selector Header -->
            <Bitmap profile="rhmMachineHeaderBox" position="20px -114px" size="1360px 40px">
                <Button id="btnPrevCombine" profile="rhmSelectorButton" position="8px -5px" size="32px 30px" text="&lt;" onClick="onClickPrevCombine" />
                <Button id="btnNextCombine" profile="rhmSelectorButton" position="44px -5px" size="32px 30px" text="&gt;" onClick="onClickNextCombine" />
                <Bitmap profile="rhmIcon" imageSliceId="rhmUi.icon_tab_trip" position="88px -8px" size="24px 24px" />
                <Text profile="rhmCardTitle" id="selectedCombineTitle" position="122px -10px" size="780px 22px" text="--" />
                <Text profile="rhmCardSubValue" id="fleetCountText" position="930px -10px" size="410px 22px" text="--" textAlignment="right" />
            </Bitmap>

            <!-- CARD 1: Status & Field -->
            <Bitmap profile="rhmCardContainer" position="20px -162px" size="440px 198px">
                <Bitmap profile="rhmIcon" imageSliceId="rhmUi.icon_field" position="18px -12px" size="20px 20px" />
                <Text profile="rhmCardTitle" position="46px -14px" size="375px 20px" text="$l10n_rhm_card_field_harvest" />

                <!-- Slot 1: Field -->
                <Text profile="rhmCardSubValue" position="20px -46px" size="180px 14px" text="$l10n_rhm_col_field" />
                <Text profile="rhmCardHighlightValue" id="card1FieldNumber" position="20px -64px" size="180px 26px" text="--" />

                <!-- Slot 2: Crop -->
                <Text profile="rhmCardSubValue" position="220px -46px" size="195px 14px" text="$l10n_rhm_crop_type" />
                <Text profile="rhmCardValue" id="card1CropType" position="220px -64px" size="195px 26px" text="--" />

                <!-- Slot 3: Driver -->
                <Text profile="rhmCardSubValue" position="20px -100px" size="180px 14px" text="$l10n_rhm_col_driver" />
                <Text profile="rhmCardValue" id="card1DriverText" position="20px -118px" size="180px 26px" text="--" />

                <!-- Slot 4: Cutter Width -->
                <Text profile="rhmCardSubValue" position="220px -100px" size="195px 14px" text="$l10n_rhm_col_cutter" />
                <Text profile="rhmCardValue" id="card1CutterWidth" position="220px -118px" size="195px 26px" text="0.0 m" />

                <!-- Slot 5: Grain Tank -->
                <Text profile="rhmCardSubValue" position="20px -156px" size="120px 18px" text="$l10n_rhm_col_tank" />
                <Text profile="rhmCardHighlightValue" id="card1GrainTank" position="140px -158px" size="275px 22px" text="0 L (0%)" textSize="16px" />
            </Bitmap>

            <!-- CARD 2: Performance & Harvest -->
            <Bitmap profile="rhmCardContainer" position="480px -162px" size="440px 198px">
                <Bitmap profile="rhmIcon" imageSliceId="rhmUi.icon_speed" position="18px -12px" size="20px 20px" />
                <Text profile="rhmCardTitle" position="46px -14px" size="375px 20px" text="$l10n_rhm_card_performance" />

                <!-- Slot 1: Speed -->
                <Text profile="rhmCardSubValue" position="20px -46px" size="180px 14px" text="$l10n_rhm_col_speed" />
                <Text profile="rhmCardValue" id="card2SpeedText" position="20px -64px" size="180px 26px" text="0.0 km/h" />

                <!-- Slot 2: Throughput -->
                <Text profile="rhmCardSubValue" position="220px -46px" size="195px 14px" text="$l10n_rhm_col_throughput" />
                <Text profile="rhmCardHighlightValue" id="card2ThroughputText" position="220px -64px" size="195px 26px" text="0.0 t/h" />

                <!-- Slot 3: Harvested -->
                <Text profile="rhmCardSubValue" position="20px -100px" size="180px 14px" text="$l10n_rhm_col_harvested" />
                <Text profile="rhmCardHighlightValue" id="card2HarvestedText" position="20px -118px" size="180px 26px" text="0.0 t" textSize="18px" />

                <!-- Slot 4: Realtime Yield -->
                <Text profile="rhmCardSubValue" position="220px -100px" size="195px 14px" text="$l10n_rhm_col_yield" />
                <Text profile="rhmCardValue" id="card2YieldText" position="220px -118px" size="195px 26px" text="0.00 t/ha" />

                <!-- Slot 5: Operating Hours -->
                <Text profile="rhmCardSubValue" position="20px -156px" size="120px 18px" text="$l10n_rhm_col_hours" />
                <Text profile="rhmCardValue" id="card2OperatingHours" position="140px -158px" size="275px 22px" text="0.0 h" textSize="16px" />
            </Bitmap>

            <!-- CARD 3: Load & Losses -->
            <Bitmap profile="rhmCardContainer" position="940px -162px" size="440px 198px">
                <Bitmap profile="rhmIcon" imageSliceId="rhmUi.icon_loss" position="18px -12px" size="20px 20px" />
                <Text profile="rhmCardTitle" position="46px -14px" size="375px 20px" text="$l10n_rhm_card_loss_finances" />

                <!-- Slot 1: Engine Load -->
                <Text profile="rhmCardSubValue" position="20px -46px" size="180px 14px" text="$l10n_rhm_col_load" />
                <Text profile="rhmCardHighlightValue" id="card3EngineLoad" position="20px -64px" size="180px 26px" text="0%" />

                <!-- Slot 2: Loss % -->
                <Text profile="rhmCardSubValue" position="220px -46px" size="195px 14px" text="$l10n_rhm_col_loss" />
                <Text profile="rhmCardWarningValue" id="card3LossPct" position="220px -64px" size="195px 26px" text="0.00%" />

                <!-- Slot 3: Loss Volume -->
                <Text profile="rhmCardSubValue" position="20px -100px" size="180px 14px" text="$l10n_rhm_loss_volume" />
                <Text profile="rhmCardWarningValue" id="card3LossVolume" position="20px -118px" size="180px 26px" text="0.0 t" textSize="18px" />

                <!-- Slot 4: Efficiency Rank -->
                <Text profile="rhmCardSubValue" position="220px -100px" size="195px 14px" text="$l10n_rhm_col_rank" />
                <Text profile="rhmCardHighlightValue" id="card3RankText" position="220px -118px" size="195px 26px" text="[A]" textSize="18px" />

                <!-- Slot 5: Wear State -->
                <Text profile="rhmCardSubValue" position="20px -156px" size="120px 18px" text="$l10n_rhm_col_wear" />
                <Text profile="rhmCardWarningValue" id="card3WearText" position="140px -158px" size="275px 22px" text="0%" textSize="16px" />
            </Bitmap>

            <!-- Fleet Table Header -->
            <GuiElement profile="rhmTableHeaderBox" position="20px -368px" size="1360px 24px">
                <Button profile="rhmTableHeader" position="10px -2px" size="310px 20px" text="$l10n_rhm_col_machine" handleFocus="false" />
                <Button profile="rhmTableHeader" position="330px -2px" size="120px 20px" text="$l10n_rhm_col_field" handleFocus="false" />
                <Button profile="rhmTableHeader" position="460px -2px" size="190px 20px" text="$l10n_rhm_col_status" handleFocus="false" />
                <Button profile="rhmTableHeader" position="660px -2px" size="140px 20px" text="$l10n_rhm_col_speed" handleFocus="false" />
                <Button profile="rhmTableHeader" position="810px -2px" size="140px 20px" text="$l10n_rhm_col_load" handleFocus="false" />
                <Button profile="rhmTableHeader" position="960px -2px" size="140px 20px" text="$l10n_rhm_col_loss" handleFocus="false" />
                <Button profile="rhmTableHeader" position="1110px -2px" size="230px 20px" text="$l10n_rhm_col_tank" handleFocus="false" />
            </GuiElement>

            <!-- Fleet Table Content -->
            <SmoothList id="fleetTable" profile="rhmTable" position="20px -396px" size="1360px 260px">
                <ListItem profile="rhmListItem">
                    <Text profile="rhmRowCellLeft" name="machineName" position="10px 0px" size="310px 38px" />
                    <Text profile="rhmRowCellLeft" name="fieldStr" position="330px 0px" size="120px 38px" />
                    <Text profile="rhmRowCellLeft" name="statusStr" position="460px 0px" size="190px 38px" />
                    <Text profile="rhmRowCellLeft" name="speedStr" position="660px 0px" size="140px 38px" />
                    <Text profile="rhmRowCellLeft" name="loadStr" position="810px 0px" size="140px 38px" />
                    <Text profile="rhmRowCellLeft" name="lossStr" position="960px 0px" size="140px 38px" />
                    <Text profile="rhmRowCellLeft" name="tankStr" position="1110px 0px" size="230px 38px" />
                </ListItem>
            </SmoothList>

            <!-- Scrollbar Slider -->
            <ThreePartBitmap profile="rhmSliderBox" position="1385px -396px" size="6px 260px">
                <Slider profile="fs25_listSlider" dataElementId="fleetTable" />
            </ThreePartBitmap>
        </GuiElement>

        <!-- ================================================================= -->
        <!-- VIEW MODE 2: SEASON HISTORY PANEL                                 -->
        <!-- ================================================================= -->
        <GuiElement id="historyPanel" profile="rhmSubPanel" position="0px 0px" size="1400px 700px" visible="false">
            <!-- Season Summary Metrics Banner (KPI Chips) -->
            <GuiElement profile="rhmKpiBar" position="20px -114px" size="1360px 58px">
                <!-- Chip 1: Total Area -->
                <Bitmap profile="rhmKpiChip" position="0px -5px" size="328px 48px">
                    <Bitmap profile="rhmIcon" imageSliceId="rhmUi.icon_area" position="12px -10px" size="28px 28px" />
                    <Text profile="rhmKpiLabel" position="48px -6px" size="260px 14px" text="$l10n_rhm_hist_total_area" />
                    <Text profile="rhmCardValue" id="histTotalAreaText" position="48px -22px" size="260px 22px" text="0.00 ha" textSize="20px" />
                </Bitmap>

                <!-- Chip 2: Total Harvest -->
                <Bitmap profile="rhmKpiChip" position="344px -5px" size="328px 48px">
                    <Bitmap profile="rhmIcon" imageSliceId="rhmUi.icon_harvest" position="12px -10px" size="28px 28px" />
                    <Text profile="rhmKpiLabel" position="48px -6px" size="260px 14px" text="$l10n_rhm_hist_total_harvest" />
                    <Text profile="rhmCardHighlightValue" id="histTotalHarvestText" position="48px -22px" size="260px 22px" text="0.0 t" textSize="20px" />
                </Bitmap>

                <!-- Chip 3: Avg Loss -->
                <Bitmap profile="rhmKpiChip" position="688px -5px" size="328px 48px">
                    <Bitmap profile="rhmIcon" imageSliceId="rhmUi.icon_loss" position="12px -10px" size="28px 28px" />
                    <Text profile="rhmKpiLabel" position="48px -6px" size="260px 14px" text="$l10n_rhm_hist_avg_loss" />
                    <Text profile="rhmCardWarningValue" id="histAvgLossText" position="48px -22px" size="260px 22px" text="0.00%" textSize="20px" />
                </Bitmap>

                <!-- Chip 4: Total Financial Loss -->
                <Bitmap profile="rhmKpiChip" position="1032px -5px" size="328px 48px">
                    <Bitmap profile="rhmIcon" imageSliceId="rhmUi.icon_money" position="12px -10px" size="28px 28px" />
                    <Text profile="rhmKpiLabel" position="48px -6px" size="260px 14px" text="$l10n_rhm_hist_total_money" />
                    <Text profile="rhmCardAlertValue" id="histTotalMoneyText" position="48px -22px" size="260px 22px" text="-$0" textSize="20px" />
                </Bitmap>
            </GuiElement>

            <!-- History Table Header Box -->
            <GuiElement profile="rhmTableHeaderBox" position="20px -188px" size="1360px 24px">
                <Button profile="rhmTableHeader" position="10px -2px" size="90px 20px" text="$l10n_rhm_col_season" handleFocus="false" />
                <Button profile="rhmTableHeader" position="110px -2px" size="110px 20px" text="$l10n_rhm_col_field" handleFocus="false" />
                <Button profile="rhmTableHeader" position="230px -2px" size="220px 20px" text="$l10n_rhm_crop_type" handleFocus="false" />
                <Button profile="rhmTableHeader" position="460px -2px" size="160px 20px" text="$l10n_rhm_col_area" handleFocus="false" />
                <Button profile="rhmTableHeader" position="630px -2px" size="200px 20px" text="$l10n_rhm_col_harvested" handleFocus="false" />
                <Button profile="rhmTableHeader" position="840px -2px" size="160px 20px" text="$l10n_rhm_col_yield" handleFocus="false" />
                <Button profile="rhmTableHeader" position="1010px -2px" size="150px 20px" text="$l10n_rhm_col_loss" handleFocus="false" />
                <Button profile="rhmTableHeader" position="1170px -2px" size="170px 20px" text="$l10n_rhm_col_money" handleFocus="false" />
            </GuiElement>

            <!-- History Table Content -->
            <SmoothList id="historyTable" profile="rhmTable" position="20px -216px" size="1360px 438px">
                <ListItem profile="rhmListItem">
                    <Text profile="rhmRowCellLeft" name="histYear" position="10px 0px" size="90px 38px" />
                    <Text profile="rhmRowCellLeft" name="histField" position="110px 0px" size="110px 38px" />
                    <Text profile="rhmRowCellLeft" name="histCrop" position="230px 0px" size="220px 38px" />
                    <Text profile="rhmRowCellLeft" name="histArea" position="460px 0px" size="160px 38px" />
                    <Text profile="rhmRowCellLeft" name="histHarvested" position="630px 0px" size="200px 38px" />
                    <Text profile="rhmRowCellLeft" name="histYield" position="840px 0px" size="160px 38px" />
                    <Text profile="rhmRowCellLeft" name="histLoss" position="1010px 0px" size="150px 38px" />
                    <Text profile="rhmRowCellLeft" name="histMoney" position="1170px 0px" size="170px 38px" />
                </ListItem>
            </SmoothList>

            <!-- Scrollbar Slider -->
            <ThreePartBitmap profile="rhmSliderBox" position="1385px -216px" size="6px 438px">
                <Slider profile="fs25_listSlider" dataElementId="historyTable" />
            </ThreePartBitmap>
        </GuiElement>
    </GuiElement>
</GUI>

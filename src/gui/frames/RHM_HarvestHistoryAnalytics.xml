        <!-- RIGHT PANEL: Scorecard & Operator Recommendations -->
        <GuiElement profile="rhmCardContainer" position="710px -78px" size="670px 530px">
            <RoundCorner profile="rhmCardSurface" />
            <Text profile="rhmCardTitle" position="24px -16px" size="620px 24px" text="$l10n_rhm_scorecard_title" />

            <!-- Operator Efficiency Rank -->
            <Text profile="rhmCardHighlightValue" id="rankBadgeText" position="24px -56px" size="90px 48px" text="[A]" textSize="42px" />
            <Text profile="rhmSectionTitle" id="rankTitleText" position="120px -58px" size="520px 26px" text="Rank A: Optimal" textSize="20px" />
            <Text profile="rhmCardDetailText" id="rankDescText" position="120px -88px" size="520px 44px" text="..." textSize="14px" textMaxNumLines="2" />

            <!-- Contextual Guidance / Recommendations -->
            <Bitmap profile="rhmIcon" imageSliceId="rhmUi.icon_advice" position="24px -156px" size="24px 24px" />
            <Text profile="rhmCardTitle" position="56px -156px" size="580px 24px" text="$l10n_rhm_guidance_title" />
            <Text profile="rhmDescriptiveText" id="adviceText" position="24px -192px" size="622px 310px" text="..." textSize="15px" />
        </GuiElement>
    </GuiElement>
</GUI>

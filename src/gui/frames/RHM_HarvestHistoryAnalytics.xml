<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI>
    <GuiElement profile="uiInGameMenuFrame">
        <!-- Page header with icon and title -->
        <GuiElement profile="fs25_menuHeaderPanel">
            <Bitmap profile="fs25_menuHeaderIconBg">
                <Bitmap profile="fs25_menuHeaderIcon" imageSliceId="rhmUi.icon_tab_analytics" />
            </Bitmap>
            <Text profile="fs25_menuHeaderTitle" text="$l10n_rhm_tab_analytics" />
        </GuiElement>

        <Text profile="rhmDescriptiveText" text="$l10n_rhm_tab_analytics_desc" position="20px -46px" width="1400px" />

        <!-- LEFT PANEL: Loss Root Causes (Progress Bars) -->
        <Bitmap profile="rhmCardContainer" position="20px -96px" size="680px 490px">
            <Bitmap profile="rhmIcon" imageSliceId="rhmUi.icon_loss" position="20px -16px" size="24px 24px" />
            <Text profile="rhmCardTitle" position="52px -18px" size="600px 22px" text="$l10n_rhm_causes_title" />

            <!-- Cause 1: Speed & Overload -->
            <Bitmap profile="rhmIcon" imageSliceId="rhmUi.icon_cause_speed" position="20px -64px" size="24px 24px" />
            <Text profile="rhmCardSubValue" position="52px -64px" size="440px 18px" text="$l10n_rhm_cause_speed" />
            <Text profile="rhmCardValueRight" id="speedValText" position="500px -64px" size="160px 20px" text="0.0%" />
            <Bitmap id="speedBarBg" profile="rhmProgressBarBg" position="52px -92px" size="608px 12px">
                <Bitmap id="speedBarFill" profile="rhmProgressBarFill" position="0px 0px" size="10px 12px" />
            </Bitmap>

            <!-- Cause 2: Moisture & Dew -->
            <Bitmap profile="rhmIcon" imageSliceId="rhmUi.icon_cause_moisture" position="20px -144px" size="24px 24px" />
            <Text profile="rhmCardSubValue" position="52px -144px" size="440px 18px" text="$l10n_rhm_cause_moisture" />
            <Text profile="rhmCardValueRight" id="moistureValText" position="500px -144px" size="160px 20px" text="0.0%" />
            <Bitmap id="moistureBarBg" profile="rhmProgressBarBg" position="52px -172px" size="608px 12px">
                <Bitmap id="moistureBarFill" profile="rhmProgressBarFill" position="0px 0px" size="10px 12px" />
            </Bitmap>

            <!-- Cause 3: Mechanical Wear -->
            <Bitmap profile="rhmIcon" imageSliceId="rhmUi.icon_cause_wear" position="20px -224px" size="24px 24px" />
            <Text profile="rhmCardSubValue" position="52px -224px" size="440px 18px" text="$l10n_rhm_cause_wear" />
            <Text profile="rhmCardValueRight" id="wearValText" position="500px -224px" size="160px 20px" text="0.0%" />
            <Bitmap id="wearBarBg" profile="rhmProgressBarBg" position="52px -252px" size="608px 12px">
                <Bitmap id="wearBarFill" profile="rhmProgressBarFill" position="0px 0px" size="10px 12px" />
            </Bitmap>

            <!-- Cause 4: Field Slopes -->
            <Bitmap profile="rhmIcon" imageSliceId="rhmUi.icon_cause_slope" position="20px -304px" size="24px 24px" />
            <Text profile="rhmCardSubValue" position="52px -304px" size="440px 18px" text="$l10n_rhm_cause_slope" />
            <Text profile="rhmCardValueRight" id="slopeValText" position="500px -304px" size="160px 20px" text="0.0%" />
            <Bitmap id="slopeBarBg" profile="rhmProgressBarBg" position="52px -332px" size="608px 12px">
                <Bitmap id="slopeBarFill" profile="rhmProgressBarFill" position="0px 0px" size="10px 12px" />
            </Bitmap>
        </Bitmap>

        <!-- RIGHT PANEL: Scorecard & Operator Recommendations -->
        <Bitmap profile="rhmCardContainer" position="720px -96px" size="660px 490px">
            <Bitmap profile="rhmIcon" imageSliceId="rhmUi.icon_rank" position="20px -16px" size="24px 24px" />
            <Text profile="rhmCardTitle" position="52px -18px" size="580px 22px" text="$l10n_rhm_scorecard_title" />

            <!-- Rank Badge -->
            <Bitmap profile="rhmIcon" imageSliceId="rhmUi.icon_rank" position="20px -64px" size="36px 36px" />
            <Text profile="rhmCardHighlightValue" id="rankBadgeText" position="66px -62px" size="70px 36px" text="[A]" textSize="28px" />
            <Text profile="rhmCardValue" id="rankTitleText" position="140px -64px" size="490px 28px" text="Grade A: Optimal" />
            <Text profile="rhmDescriptiveText" id="rankDescText" position="140px -96px" size="490px 48px" text="Loss rate is below 1.5% threshold." />

            <!-- Guidance Box -->
            <Bitmap profile="rhmIcon" imageSliceId="rhmUi.icon_advice" position="20px -174px" size="24px 24px" />
            <Text profile="rhmCardTitle" position="52px -176px" size="580px 22px" text="$l10n_rhm_guidance_title" />
            <Bitmap profile="rhmInnerPanel" position="20px -206px" size="620px 250px">
                <Text profile="rhmDescriptiveText" id="adviceText" position="24px -20px" size="572px 210px" text="Threshing parameters are balanced." />
            </Bitmap>
        </Bitmap>
    </GuiElement>
</GUI>

<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI>
    <GuiElement profile="uiInGameMenuFrame">
        <!-- Page header with icon and title -->
        <GuiElement profile="fs25_menuHeaderPanel">
            <Bitmap profile="fs25_menuHeaderIconBg">
                <Bitmap profile="fs25_menuHeaderIcon" imageSliceId="rhmUi.icon_field" />
            </Bitmap>
            <Text profile="fs25_menuHeaderTitle" text="$l10n_rhm_tab_fields" />
        </GuiElement>

        <Text profile="rhmDescriptiveText" text="$l10n_rhm_tab_fields_desc" position="20px -46px" width="1400px" />

        <!-- Fields Filter Bar (All / Owned / Contracts) -->
        <GuiElement id="fieldsFilterBar" profile="rhmTopNavContainer" position="20px -70px" size="1360px 38px">
            <Button id="btnFilterAll" profile="rhmSubTabFilterActive" position="0px 0px" size="140px 34px" text="$l10n_rhm_filter_all" onClick="onClickFilterAll" />
            <Button id="btnFilterOwned" profile="rhmSubTabFilter" position="148px 0px" size="140px 34px" text="$l10n_rhm_filter_owned" onClick="onClickFilterOwned" />
            <Button id="btnFilterContract" profile="rhmSubTabFilter" position="296px 0px" size="140px 34px" text="$l10n_rhm_filter_contracts" onClick="onClickFilterContract" />
        </GuiElement>

        <!-- Fields Overview Panel -->
        <GuiElement id="fieldsPanel" profile="rhmSubPanel" position="0px 0px" size="1400px 700px">
            <!-- Fields & Season Switcher Header Box -->
            <GuiElement profile="rhmStatusBandContainer" position="20px -110px" size="1360px 38px">
                <RoundCorner profile="rhmMachineHeaderBox" />
                <Button id="btnPrevSeason" profile="rhmSelectorButton" position="8px -4px" size="32px 30px" text="&lt;" onClick="onClickPrevSeason" />
                <Button id="btnNextSeason" profile="rhmSelectorButton" position="44px -4px" size="32px 30px" text="&gt;" onClick="onClickNextSeason" />
                <Bitmap profile="rhmIcon" imageSliceId="rhmUi.icon_field" position="88px -7px" size="24px 24px" />
                <Text profile="rhmStatusText" id="fieldsSummaryTitle" position="122px -8px" size="780px 22px" text="--" />
                <Text profile="rhmCardHeaderVehicle" id="fieldsSummaryCountText" position="910px -8px" size="430px 22px" text="--" textAlignment="right" />
            </GuiElement>

            <!-- CARD 1: Farmland & Status -->
            <GuiElement profile="rhmCardContainer" position="20px -156px" size="440px 214px">
                <RoundCorner profile="rhmCardSurface" />
                <Text profile="rhmCardTitle" id="fieldSummaryCard1Title" position="20px -16px" size="400px 20px" text="$l10n_rhm_card_field_land" />

                <!-- Row 1: Owned Fields & Total Area -->
                <Text profile="rhmCardSubValue" id="fieldSummaryLabel1_1" position="20px -44px" size="190px 13px" text="$l10n_rhm_fields_total_owned" />
                <Text profile="rhmCardValue" id="fieldSummaryOwnedCount" position="20px -60px" size="190px 28px" text="0" />

                <Text profile="rhmCardSubValue" id="fieldSummaryLabel1_2" position="220px -44px" size="195px 13px" text="$l10n_rhm_hist_total_area" />
                <Text profile="rhmCardValue" id="fieldSummaryTotalArea" position="220px -60px" size="195px 28px" text="0.00 ha" />

                <!-- Row 2: Harvested Area & Contract Fields -->
                <Text profile="rhmCardSubValue" id="fieldSummaryLabel1_3" position="20px -98px" size="190px 13px" text="$l10n_rhm_col_area" />
                <Text profile="rhmCardValue" id="fieldSummaryHarvestedArea" position="20px -114px" size="190px 28px" text="0.00 ha" />

                <Text profile="rhmCardSubValue" id="fieldSummaryLabel1_4" position="220px -98px" size="195px 13px" text="$l10n_rhm_contract_tag" />
                <Text profile="rhmCardValue" id="fieldSummaryContractCount" position="220px -114px" size="195px 28px" text="0" />

                <!-- Row 3: Progress Status Banner (Full Width) -->
                <Text profile="rhmCardSubValue" id="fieldSummaryLabel1_5" position="20px -152px" size="400px 13px" text="$l10n_rhm_col_status" />
                <Text profile="rhmCardValue" id="fieldSummaryProgressText" position="20px -168px" size="400px 26px" text="--" textSize="20px" />
            </GuiElement>

            <!-- CARD 2: Production & Yield -->
            <GuiElement profile="rhmCardContainer" position="480px -156px" size="440px 214px">
                <RoundCorner profile="rhmCardSurface" />
                <Text profile="rhmCardTitle" id="fieldSummaryCard2Title" position="20px -16px" size="400px 20px" text="$l10n_rhm_card_field_yield" />

                <!-- Row 1: Clean Harvest & Farm Yield -->
                <Text profile="rhmCardSubValue" id="fieldSummaryLabel2_1" position="20px -44px" size="190px 13px" text="$l10n_rhm_clean_harvest" />
                <Text profile="rhmCardValue" id="fieldSummaryTotalHarvest" position="20px -60px" size="190px 28px" text="0.0 t" />

                <Text profile="rhmCardSubValue" id="fieldSummaryLabel2_2" position="220px -44px" size="195px 13px" text="$l10n_rhm_col_yield" />
                <Text profile="rhmCardValue" id="fieldSummaryAvgYield" position="220px -60px" size="195px 28px" text="0.00 t/ha" />

                <!-- Row 2: Best Field & Top Crop -->
                <Text profile="rhmCardSubValue" id="fieldSummaryLabel2_3" position="20px -98px" size="190px 13px" text="$l10n_rhm_fields_best_yield" />
                <Text profile="rhmCardValue" id="fieldSummaryBestField" position="20px -114px" size="190px 28px" text="--" textSize="18px" />

                <Text profile="rhmCardSubValue" id="fieldSummaryLabel2_4" position="220px -98px" size="195px 13px" text="$l10n_rhm_kpi_crop" />
                <Text profile="rhmCardValue" id="fieldSummaryTopCrop" position="220px -114px" size="195px 28px" text="--" textSize="18px" />

                <!-- Row 3: Operating Work Time (Full Width) -->
                <Text profile="rhmCardSubValue" id="fieldSummaryLabel2_5" position="20px -152px" size="400px 13px" text="$l10n_rhm_session_duration" />
                <Text profile="rhmCardValue" id="fieldSummaryWorkDuration" position="20px -168px" size="400px 26px" text="00:00" textSize="20px" />
            </GuiElement>

            <!-- CARD 3: Losses & Economic Ledger -->
            <GuiElement profile="rhmCardContainer" position="940px -156px" size="440px 214px">
                <RoundCorner profile="rhmCardSurface" />
                <Text profile="rhmCardTitle" id="fieldSummaryCard3Title" position="20px -16px" size="400px 20px" text="$l10n_rhm_card_field_losses" />

                <!-- Row 1: Loss Volume & Loss Share -->
                <Text profile="rhmCardSubValue" id="fieldSummaryLabel3_1" position="20px -44px" size="190px 13px" text="$l10n_rhm_loss_volume" />
                <Text profile="rhmCardValue" id="fieldSummaryTotalLost" position="20px -60px" size="190px 28px" text="0.0 t" />

                <Text profile="rhmCardSubValue" id="fieldSummaryLabel3_2" position="220px -44px" size="195px 13px" text="$l10n_rhm_loss_share" />
                <Text profile="rhmCardValue" id="fieldSummaryAvgLossPct" position="220px -60px" size="195px 28px" text="0.00%" />

                <!-- Row 2: Net Operating Margin & Efficiency Class -->
                <Text profile="rhmCardSubValue" id="fieldSummaryLabel3_3" position="20px -98px" size="190px 13px" text="$l10n_rhm_net_margin" />
                <Text profile="rhmCardValue" id="fieldSummaryTotalMoney" position="20px -114px" size="190px 28px" text="$0" textSize="20px" />

                <Text profile="rhmCardSubValue" id="fieldSummaryLabel3_4" position="220px -98px" size="195px 13px" text="$l10n_rhm_efficiency_index" />
                <Text profile="rhmCardValue" id="fieldSummaryEfficiencyRank" position="220px -114px" size="195px 28px" text="[A]" textSize="20px" />

                <!-- Row 3: Dominant Cause Banner (Full Width) -->
                <Text profile="rhmCardSubValue" id="fieldSummaryLabel3_5" position="20px -152px" size="400px 13px" text="$l10n_rhm_causes_title" />
                <Text profile="rhmCardValue" id="fieldSummaryDominantCause" position="20px -168px" size="400px 26px" text="--" textSize="18px" />
            </GuiElement>

            <!-- Table Header Box -->
            <GuiElement profile="rhmTableHeaderContainer" position="20px -376px" size="1360px 26px">
                <RoundCorner profile="rhmTableHeaderBox" />
                <Button profile="rhmTableHeader" position="10px -3px" size="180px 20px" text="$l10n_rhm_col_field" handleFocus="false" />
                <Button profile="rhmTableHeader" position="200px -3px" size="100px 20px" text="$l10n_rhm_col_status" handleFocus="false" />
                <Button profile="rhmTableHeader" position="310px -3px" size="100px 20px" text="$l10n_rhm_col_area" handleFocus="false" />
                <Button profile="rhmTableHeader" position="420px -3px" size="180px 20px" text="$l10n_rhm_crop_type" handleFocus="false" />
                <Button profile="rhmTableHeader" position="610px -3px" size="210px 20px" text="$l10n_rhm_col_harvested" handleFocus="false" />
                <Button profile="rhmTableHeader" position="830px -3px" size="140px 20px" text="$l10n_rhm_col_yield" handleFocus="false" />
                <Button profile="rhmTableHeader" position="980px -3px" size="130px 20px" text="$l10n_rhm_col_loss" handleFocus="false" />
                <Button profile="rhmTableHeader" position="1120px -3px" size="170px 20px" text="$l10n_rhm_net_margin" handleFocus="false" />
                <Button profile="rhmTableHeader" position="1300px -3px" size="50px 20px" text="$l10n_rhm_col_rank" handleFocus="false" />
            </GuiElement>

            <!-- Fields Table Content -->
            <SmoothList id="fieldsTable" profile="rhmTable" position="20px -404px" size="1360px 250px" onClick="onClickListItem" onSelectionChanged="onListSelectionChanged">
                <ListItem profile="rhmListItem">
                    <Text profile="rhmRowCellLeft" name="colField" position="10px 0px" size="180px 38px" />
                    <Text profile="rhmRowCellLeft" name="colStatus" position="200px 0px" size="100px 38px" />
                    <Text profile="rhmRowCellLeft" name="colArea" position="310px 0px" size="100px 38px" />
                    <Text profile="rhmRowCellLeft" name="colCrop" position="420px 0px" size="180px 38px" />
                    <Text profile="rhmRowCellLeft" name="colHarvested" position="610px 0px" size="210px 38px" />
                    <Text profile="rhmRowCellLeft" name="colYield" position="830px 0px" size="140px 38px" />
                    <Text profile="rhmRowCellLeft" name="colLoss" position="980px 0px" size="130px 38px" />
                    <Text profile="rhmRowCellLeft" name="colMoney" position="1120px 0px" size="170px 38px" />
                    <Text profile="rhmRowCellLeft" name="colRank" position="1300px 0px" size="50px 38px" />
                </ListItem>
            </SmoothList>

            <!-- Scrollbar Slider -->
            <ThreePartBitmap profile="rhmSliderBox" position="1385px -404px" size="6px 250px">
                <Slider profile="fs25_listSlider" dataElementId="fieldsTable" />
            </ThreePartBitmap>
        </GuiElement>
    </GuiElement>
</GUI>
